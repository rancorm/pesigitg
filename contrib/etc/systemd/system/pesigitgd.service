[Unit]
Description=pesigitg QUIC-aware load balancer
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/pesigitgd -f -c /etc/pesigitg/pesigitgd.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
WatchdogSec=30

# FDSTORE: preserve AF_XDP socket + UMEM memfd FDs across SIGUSR2
# handoff. Two FDs per RX queue (sockfd, umem memfd); 128 is
# generous headroom for boxes with many queues.
FileDescriptorStoreMax=128

# /run/pesigitg/ for the optional JSON status socket (status_socket = ...)
RuntimeDirectory=pesigitg
RuntimeDirectoryMode=0755

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
